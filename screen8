import 'package:flutter/material.dart';
import 'screen7.dart';

class MySignaturesScreen extends StatefulWidget {
  const MySignaturesScreen({super.key});

  @override
  State<MySignaturesScreen> createState() => _MySignaturesScreenState();
}

class _MySignaturesScreenState extends State<MySignaturesScreen> {
  final List<dynamic> _signatures = [];

  void _delete(int index) {
    setState(() => _signatures.removeAt(index));
    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(content: Text('Signature removed.')),
    );
  }

  @override
  Widget build(BuildContext context) {
    const navy = Color(0xFF0F172A);
    const violet = Color(0xFF7C3AED);

    return Scaffold(
      appBar: AppBar(
        title: const Text('My signatures', style: TextStyle(fontWeight: FontWeight.w900)),
        actions: [
          IconButton(
            onPressed: () {
              Navigator.pop(context);
            },
            icon: const Icon(Icons.add_circle_outline_rounded, color: violet),
          ),
          const SizedBox(width: 5),
        ],
      ),
      body: SafeArea(
        child: _signatures.isEmpty
            ? Center(
          child: Padding(
            padding: const EdgeInsets.all(30),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                Container(
                  width: 78,
                  height: 78,
                  decoration: const BoxDecoration(color: Color(0xFFE9EAFE), shape: BoxShape.circle),
                  child: const Icon(Icons.folder_open_rounded, color: violet, size: 38),
                ),
                const SizedBox(height: 17),
                const Text('Your collection is empty', style: TextStyle(color: navy, fontSize: 18, fontWeight: FontWeight.w900)),
                const SizedBox(height: 7),
                const Text(
                  'Create and save a signature to see it here.',
                  textAlign: TextAlign.center,
                  style: TextStyle(color: Color(0xFF718096), fontSize: 13, height: 1.5),
                ),
                const SizedBox(height: 20),
                SizedBox(
                  width: 220,
                  height: 48,
                  child: ElevatedButton.icon(
                    onPressed: () => Navigator.pop(context),
                    icon: const Icon(Icons.add_rounded, color: Colors.white),
                    label: const Text('Create signature', style: TextStyle(color: Colors.white)),
                    style: ElevatedButton.styleFrom(
                      backgroundColor: violet,
                      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
                    ),
                  ),
                ),
              ],
            ),
          ),
        )
            : ListView.separated(
          padding: const EdgeInsets.fromLTRB(19, 12, 19, 25),
          itemCount: _signatures.length,
          separatorBuilder: (_, __) => const SizedBox(height: 13),
          itemBuilder: (context, index) => _SavedCard(
            signature: _signatures[index],
            onTap: () => Navigator.push(
              context,
              MaterialPageRoute(
                builder: (_) => PreviewScreen(
                  signature: _signatures[index],
                  fromSaved: true,
                ),
              ),
            ),
            onDelete: () => _delete(index),
          ),
        ),
      ),
      bottomNavigationBar: NavigationBar(
        selectedIndex: 1,
        height: 66,
        backgroundColor: Colors.white,
        onDestinationSelected: (i) {
          if (i == 0) Navigator.pop(context);
        },
        destinations: const [
          NavigationDestination(icon: Icon(Icons.home_outlined), label: 'Home'),
          NavigationDestination(icon: Icon(Icons.folder_open_rounded), selectedIcon: Icon(Icons.folder_rounded), label: 'My Signatures'),
        ],
      ),
    );
  }
}

class _SavedCard extends StatelessWidget {
  final dynamic signature;
  final VoidCallback onTap;
  final VoidCallback? onDelete;

  const _SavedCard({required this.signature, required this.onTap, this.onDelete});

  @override
  Widget build(BuildContext context) {
    const navy = Color(0xFF0F172A);
    const violet = Color(0xFF7C3AED);

    return Container(
      padding: const EdgeInsets.all(13),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(19),
        border: Border.all(color: const Color(0xFFE7EBF3)),
      ),
      child: Column(
        children: [
          GestureDetector(
            onTap: onTap,
            child: Container(
              height: 100,
              width: double.infinity,
              decoration: BoxDecoration(color: const Color(0xFFFBFCFF), borderRadius: BorderRadius.circular(13)),
              child: const Center(child: Text('Signature Preview')),
            ),
          ),
          const SizedBox(height: 10),
          Row(
            children: [
              const Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text('My Signature', style: TextStyle(color: navy, fontWeight: FontWeight.w900, fontSize: 13)),
                    SizedBox(height: 3),
                    Text('Date', style: TextStyle(color: Color(0xFF94A3B8), fontSize: 10)),
                  ],
                ),
              ),
              IconButton(tooltip: 'Preview', onPressed: onTap, icon: const Icon(Icons.visibility_outlined, color: violet)),
              if (onDelete != null)
                IconButton(tooltip: 'Delete', onPressed: onDelete, icon: const Icon(Icons.delete_outline_rounded, color: Color(0xFFDC2626))),
            ],
          ),
        ],
      ),
    );
  }
}
